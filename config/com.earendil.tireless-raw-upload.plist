<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.earendil.tireless-raw-upload</string>
  <key>Description</key>
  <string>Upload this Mac's Codex, Pi, and OMP sessions to Tireless Ledger</string>
  <key>ProgramArguments</key>
  <array><string>__UPLOAD_SCRIPT__</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__STDOUT__</string>
  <key>StandardErrorPath</key><string>__STDERR__</string>
</dict>
</plist>
