# Copy to ~/.config/tireless-ledger/raw-upload.env and chmod 600.
TIRELESS_RAW_URL=s3://YOUR_BUCKET/session-recall-raw-v1
TIRELESS_S3_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
TIRELESS_UPLOAD_HOST=mbp14
AWS_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# Optional; these defaults normally need no changes.
# TIRELESS_CODEX_SESSIONS=$HOME/.codex/sessions
# TIRELESS_PI_SESSIONS=$HOME/.pi/agent/sessions
