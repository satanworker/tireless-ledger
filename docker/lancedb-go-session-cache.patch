+// FragmentCount returns the number of data fragments in the table. It is an
+// optional capability used by applications that compact on a fragment limit.
+func (t *Table) FragmentCount(_ context.Context) (int, error) {
+	t.mu.RLock()
+	defer t.mu.RUnlock()
+	if t.closed || t.handle == nil {
+		return 0, fmt.Errorf("table is closed")
+	}
+	var count C.int64_t
+	result := C.simple_lancedb_table_count_fragments(t.handle, &count)
+	defer C.simple_lancedb_result_free(result)
+	if !result.SUCCESS {
+		if result.ERROR_MESSAGE != nil {
+			return 0, fmt.Errorf("failed to count fragments: %s", C.GoString(result.ERROR_MESSAGE))
+		}
+		return 0, fmt.Errorf("failed to count fragments: unknown error")
+	}
+	return int(count), nil
+}
+
