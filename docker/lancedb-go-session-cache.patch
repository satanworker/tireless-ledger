+/// Count data fragments in a table.
+#[no_mangle]
+#[allow(clippy::not_unsafe_ptr_arg_deref)]
+pub extern "C" fn simple_lancedb_table_count_fragments(
+    table_handle: *mut c_void,
+    count: *mut i64,
+) -> *mut SimpleResult {
+    let result = std::panic::catch_unwind(|| -> SimpleResult {
+        if table_handle.is_null() || count.is_null() {
+            return SimpleResult::error("Invalid null arguments".to_string());
+        }
+        let table = unsafe { &*(table_handle as *const lancedb::Table) };
+        let dataset = match table.dataset() {
+            Some(dataset) => dataset,
+            None => return SimpleResult::error("Fragment count requires a native table".to_string()),
+        };
+        let rt = get_simple_runtime();
+        match rt.block_on(async { dataset.get().await.map(|ds| ds.count_fragments()) }) {
+            Ok(n) => {
+                unsafe { *count = n as i64 };
+                SimpleResult::ok()
+            }
+            Err(e) => SimpleResult::error(format!("Failed to count fragments: {}", e)),
+        }
+    });
+    match result {
+        Ok(res) => Box::into_raw(Box::new(res)),
+        Err(_) => Box::into_raw(Box::new(SimpleResult::error(
+            "Panic in simple_lancedb_table_count_fragments".to_string(),
+        ))),
+    }
+}
+
