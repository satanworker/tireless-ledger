[Unit]
Description=Optimize Tireless Ledger Lance indexes
ConditionPathExists=%h/tireless-ledger/docker-compose.yml

[Service]
Type=oneshot
WorkingDirectory=%h/tireless-ledger
ExecStart=%h/tireless-ledger/scripts/optimize-lance.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=30min
